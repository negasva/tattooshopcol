# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_ADMIN_PASSWORD=your_admin_password_here

# Wompi Payment Gateway
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=pub_test_XXXXXXXXXXXXXXXX
WOMPI_PRIVATE_KEY=prv_test_XXXXXXXXXXXXXXXX
WOMPI_INTEGRITY_SECRET=test_integrity_XXXXXXXXXXXXXXXX

# Supabase Service Role (solo servidor — nunca exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Email — Resend (https://resend.com)
RESEND_API_KEY=re_XXXXXXXXXXXXXXXX
RESEND_FROM_EMAIL=TattooShop Colombia <noreply@tattooshopcol.shop>

# URL pública del sitio (para links en emails)
NEXT_PUBLIC_SITE_URL=https://tattooshopcol.shop

# Cron secret — protege el endpoint /api/cron/abandoned-cart en producción
CRON_SECRET=un_secreto_largo_y_aleatorio

# Example:
# NEXT_PUBLIC_SUPABASE_URL=https://abcdefg.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# NEXT_PUBLIC_ADMIN_PASSWORD=securepassword123
# NEXT_PUBLIC_WOMPI_PUBLIC_KEY=pub_prod_XXXXXXXXXXXXXXXX
# WOMPI_PRIVATE_KEY=prv_prod_XXXXXXXXXXXXXXXX
# WOMPI_INTEGRITY_SECRET=prod_integrity_XXXXXXXXXXXXXXXX
