# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_ADMIN_PASSWORD=your_admin_password_here

# Wompi Payment Gateway
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=pub_test_XXXXXXXXXXXXXXXX
WOMPI_PRIVATE_KEY=prv_test_XXXXXXXXXXXXXXXX

# Example:
# NEXT_PUBLIC_SUPABASE_URL=https://abcdefg.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# NEXT_PUBLIC_ADMIN_PASSWORD=securepassword123
# NEXT_PUBLIC_WOMPI_PUBLIC_KEY=pub_prod_XXXXXXXXXXXXXXXX
# WOMPI_PRIVATE_KEY=prv_prod_XXXXXXXXXXXXXXXX
